{
  "name": "ai-stream-auditor",
  "version": "1.0.3",
  "description": "Audit decoded OpenAI Responses and Anthropic Messages event lifecycles for silent or malformed stream endings.",
  "keywords": [
    "ai",
    "streaming",
    "openai",
    "anthropic",
    "llm",
    "diagnostics",
    "testing"
  ],
  "license": "MIT",
  "author": "Huzaifa Asif",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huzaifa-Asif/ai-stream-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/Huzaifa-Asif/ai-stream-auditor/issues"
  },
  "homepage": "https://github.com/Huzaifa-Asif/ai-stream-auditor#readme",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test": "npm run test:core && npm run test:integration",
    "test:core": "node --test test/audit.test.js test/regressions.test.js",
    "test:integration": "node --test test/anthropic-sdk.integration.test.js",
    "test:coverage": "node --experimental-test-coverage --test",
    "test:coverage:core": "node --experimental-test-coverage --test test/audit.test.js test/regressions.test.js",
    "check:core": "npm run lint && npm run test:coverage:core && node examples/audit-openai.mjs && node examples/audit-anthropic.mjs && npm pack --dry-run",
    "check": "npm run lint && npm run test:coverage && node examples/audit-openai.mjs && node examples/audit-anthropic.mjs && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
